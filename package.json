{
  "name": "aevum-invoice-escrow",
  "version": "0.1.0",
  "private": true,
  "description": "Invoice + milestone escrow in tUSD8 on QDay Aevum testnet — freelancers get paid in stablecoin, no bank account, no gas for the client. Forked from the Aevum starter kit (MIT).",
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm -r typecheck",
    "example": "pnpm --filter examples run",
    "check:shanghai": "node tools/check-shanghai.mjs contracts/out"
  },
  "pnpm": {
    "overrides": {
      "@base-org/account": "2.2.0",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
